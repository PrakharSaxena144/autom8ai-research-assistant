# Copy to .env and fill in. Only GROQ_API_KEY is required.

# ---------------------------------------------------------------------------------------------
# LLM: Groq free tier. Create a key (no card needed) at https://console.groq.com/keys
# ---------------------------------------------------------------------------------------------
GROQ_API_KEY=

# "main" model writes the plan and the final answer; "fast" model grades evidence and fact-checks.
# Free-tier limits are per model, so fallbacks also add capacity when one model is rate-limited.
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-20b
FAST_LLM_MODEL=openai/gpt-oss-20b
FAST_LLM_FALLBACK_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b
MAIN_MAX_TOKENS=2500
FAST_MAX_TOKENS=1500
LLM_MAX_RETRIES=2
LLM_TIMEOUT_S=60

# ---------------------------------------------------------------------------------------------
# Vector store: Qdrant
#   default: embedded on-disk Qdrant in ./storage/qdrant (no setup, single process)
#   optional: free 1 GB Qdrant Cloud cluster (https://cloud.qdrant.io) so data survives redeploys
# ---------------------------------------------------------------------------------------------
QDRANT_URL=
QDRANT_API_KEY=
# QDRANT_PATH=./storage/qdrant
COLLECTION_NAME=knowledge_base

# ---------------------------------------------------------------------------------------------
# Embeddings: local FastEmbed ONNX models, downloaded once (~70 MB) into MODEL_CACHE_DIR
# ---------------------------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
# MODEL_CACHE_DIR=./models

# ---------------------------------------------------------------------------------------------
# Web fallback
#   auto       -> Tavily if TAVILY_API_KEY is set, otherwise DuckDuckGo (no key)
#   tavily     -> Tavily free tier (1,000 credits/month): https://app.tavily.com
#   duckduckgo -> no key, best effort (can be rate-limited)
#   none       -> disabled
# ---------------------------------------------------------------------------------------------
WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
WEB_RESULTS=5

# ---------------------------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
MAX_UPLOAD_MB=25
# Ingest data/corpus on first start when the knowledge base is empty
SEED_ON_STARTUP=true
# SEED_DIR=./data/corpus
# Allow ingesting URLs on private/local networks (SSRF guard). Keep false on public deployments.
ALLOW_PRIVATE_URLS=false

# ---------------------------------------------------------------------------------------------
# Agent behaviour (lower these to use fewer LLM calls per question)
# ---------------------------------------------------------------------------------------------
RETRIEVAL_K=6
MAX_CANDIDATES=8
MAX_SUB_QUESTIONS=3
MAX_KB_ATTEMPTS=2
MAX_REVISIONS=1
MAX_FOLLOWUP_ROUNDS=1
HISTORY_TURNS=4
PASSAGE_CHARS=800
